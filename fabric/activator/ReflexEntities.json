        "itemId": "9c562b46-9eaa-48b0-a1e9-19ccae2c272d"
      },
      "name": "Fresh synthetic discharge pressure (stopped)"
    },
    "uniqueIdentifier": "a50c0e75-1e33-479e-8324-000000000002"

      "query": {
        "queryString": "// Prospective Activator feed; no rule/notification is activated by this query.\r\n// Include recovery samples, not only high samples. Historical fixture data stays stale.\r\ndatabase('OilGasOperationsDB').LatestCompressorMeasurements()\r\n| where MeasurementId == 'MSR-A1-DP' and SiteId == 'SITE-A' and AssetId == 'CMP-A1'\r\n| where Metric == 'DischargePressure' and EngineeringUnit == 'psi'\r\n    and not(IsStale) and ConflictCount <= 1 and isnotnull(NumericValue)\r\n| project MeasurementId,SiteId,AssetId,Metric,NumericValue,EngineeringUnit,\r\n    HighThreshold,RecoveryThreshold,EventTime,EventhouseIngestedAt,\r\n    IsHigh=NumericValue>HighThreshold,IsRecovered=NumericValue<=RecoveryThreshold\r\n"
      },
      "eventhouseItem": {
